{"schema_version": "1.1", "item_id": "mail:AQMkADAwATMwMAExLWJiADIzLTE4MmItMDACLTAwCgBGAAADqWSHJ89mKUuZ4KVQu3DScAcADAe_BM_B3kC26pFzMy9lMwAAAgEMAAAADAe_BM_B3kC26pFzMy9lMwAAAgVZAAAA", "source": "mail", "provider": "microsoft", "owner_user_id": "u_claire", "title": "Chiffres T3 — écarts sur les achats", "snippet": "Claire, Le contrôle de gestion me remonte un écart de 8,4 % sur les achats indirects au T3, concentré sur la maintenance et les prestations informatiques. Pensez-vous pouvoir l'intégrer à votre analyse avant le copil ?", "content_text": null, "created_at": "2026-11-17T15:59:20+01:00", "updated_at": "2026-11-17T16:02:45+01:00", "start_at": null, "end_at": null, "due_at": null, "completed": null, "participants": [{"name": "Victor Mabe", "email": "victor.mabe.alliance@outlook.com", "role": "from"}, {"name": "Claire Fontaine", "email": "claire.fontaine.alliance@outlook.com", "role": "to"}], "thread_id": "AQQkADAwATMwMAExLWJiADIzLTE4MmItMDACLTAwCgAQAIzgrbRVnG1Ei6Xdhf2Hwg4=", "correlation_id": null, "native_importance": "normal", "is_read": false, "url": "https://outlook.live.com/owa/?ItemID=AQMkADAwATMwMAExLWJiADIzLTE4MmItMDACLTAwCgBGAAADqWSHJ89mKUuZ4KVQu3DScAcADAe%2BBM%2BB3kC26pFzMy9lMwAAAgEMAAAADAe%2BBM%2BB3kC26pFzMy9lMwAAAgVZAAAA&exvsurl=1&viewmodel=ReadMessageItem", "acl": {"visible_to": ["u_claire"]}, "collected_at": "2026-11-19T08:30:00+01:00", "connector": {"name": "mail_graph", "version": "0.1.0"}, "attributes": null}
