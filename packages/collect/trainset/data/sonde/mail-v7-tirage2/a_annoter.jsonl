{"case_id": "sonde-20", "persona": "operations-2", "jour": "2026-11-04", "item": {"schema_version": "1.1", "item_id": "mail:operations-2-00039", "source": "mail", "provider": "demo", "owner_user_id": "u_train_operations_2", "title": "Rapport d'audit hygiène - Valmont Agroalimentaire", "snippet": "Sophie, Nous poursuivons les actions suite aux audits récents. Le rapport concernant l'hygiène est la dernière information manquante. Merci de déposer le rapport d'audit hygiène sur le portail d'ici lundi 9 novembre. À écrire : quand tu as un moment J'espère que tu vas bien. Merci ! Rachid", "content_text": null, "created_at": "2026-11-03T14:03:00+01:00", "updated_at": "2026-11-03T14:03:00+01:00", "start_at": null, "end_at": null, "due_at": null, "completed": null, "participants": [{"name": "Rachid Bernard", "email": "rachid.bernard@valmont-agro.test", "role": "from"}, {"name": "Sophie Blanc", "email": "sophie.blanc@valmont-agro.test", "role": "to"}], "thread_id": "thr-operations-2-c010", "correlation_id": null, "native_importance": "high", "is_read": false, "url": "https://mail.valmont-agro.test/owa/operations-2-00039", "acl": {"visible_to": ["u_train_operations_2"]}, "collected_at": "2026-11-03T14:03:00+01:00", "connector": {"name": "trainset", "version": "0.2.0"}, "attributes": null}}
