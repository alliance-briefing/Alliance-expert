{"case_id": "sonde-17", "persona": "commercial-2", "jour": "2026-11-13", "item": {"schema_version": "1.1", "item_id": "mail:commercial-2-00214", "source": "mail", "provider": "demo", "owner_user_id": "u_train_commercial_2", "title": "Re: Contrat-cadre Pasteur - Point bloquant", "snippet": "Suite à mon email du 21 septembre, j'attends toujours votre retour concernant le contrat-cadre Pasteur. Pourriez-vous donc bien vouloir me confirmer votre accord sur le contrat-cadre ? Urgent : ça bloque. Je vous remercie de bien vouloir me confirmer votre accord au plus vite.", "content_text": null, "created_at": "2026-11-12T08:54:00+01:00", "updated_at": "2026-11-12T08:54:00+01:00", "start_at": null, "end_at": null, "due_at": null, "completed": null, "participants": [{"name": "Agathe Haddad", "email": "agathe.haddad@groupe.scolaire.pasteur.test", "role": "from"}, {"name": "Hugo Colin", "email": "hugo.colin@lumen-equipements.test", "role": "to"}], "thread_id": "thr-commercial-2-c061", "correlation_id": null, "native_importance": "normal", "is_read": false, "url": "https://mail.lumen-equipements.test/owa/commercial-2-00214", "acl": {"visible_to": ["u_train_commercial_2"]}, "collected_at": "2026-11-12T08:54:00+01:00", "connector": {"name": "trainset", "version": "0.2.0"}, "attributes": null}}
{"case_id": "sonde-18", "persona": "drh-3", "jour": "2026-11-12", "item": {"schema_version": "1.1", "item_id": "mail:drh-3-00255", "source": "mail", "provider": "demo", "owner_user_id": "u_train_drh_3", "title": "Réunion bilan social", "snippet": "Sophie, Viens à la réunion vendredi avec une proposition pour le bilan social. Réunion vendredi 13 novembre avec l'équipe et la direction. Prépare un résumé des points importants. Merci ! Thomas", "content_text": null, "created_at": "2026-11-11T09:22:00+01:00", "updated_at": "2026-11-11T09:22:00+01:00", "start_at": null, "end_at": null, "due_at": null, "completed": null, "participants": [{"name": "Thomas Mercier", "email": "thomas.mercier@solvane.test", "role": "from"}, {"name": "Sophie Boyer", "email": "sophie.boyer@solvane.test", "role": "to"}], "thread_id": "thr-drh-3-c077", "correlation_id": null, "native_importance": "normal", "is_read": false, "url": "https://mail.solvane.test/owa/drh-3-00255", "acl": {"visible_to": ["u_train_drh_3"]}, "collected_at": "2026-11-11T09:22:00+01:00", "connector": {"name": "trainset", "version": "0.2.0"}, "attributes": null}}
