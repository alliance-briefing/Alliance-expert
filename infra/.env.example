# Copier en .env (non versionné) et remplacer les valeurs factices.
LLM_API_KEY=changeme
DATABASE_URL=postgresql://briefing:changeme@db:5432/briefing
# Authentification provisoire (en-tête X-Demo-User, données synthétiques seulement) ; vide = API fermée.
AUTH_MODE=demo
# Dossier des Items : <user>/<AAAA-MM-JJ>/items.jsonl (contrat A), écrit par le lot 1.
# Vide = journées de démonstration de contracts/fixtures/demo.
DATA_DIR=
