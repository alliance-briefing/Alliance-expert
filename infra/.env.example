# Facultatif : `docker compose up` marche sans .env (démonstration hors ligne).
# Pour changer un réglage, copier en infra/.env (non versionné) et ne garder que l'utile.
# Authentification : « demo » (identifiant au choix, données synthétiques seulement) ou
# « oidc » (OpenID Connect, Microsoft pour la démo) ; vide = API fermée.
AUTH_MODE=demo
# AUTH_MODE=oidc : fournisseur d'identité. Changer de fournisseur = changer ces valeurs.
# Microsoft : OIDC_ISSUER=https://login.microsoftonline.com/<common|id-du-locataire>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Doit être déclarée à l'identique chez le fournisseur.
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# Facultatif (PKCE suffit pour un client public) ; jamais dans le dépôt.
OIDC_CLIENT_SECRET=
# Claims qui forment l'identité (Microsoft : tid,oid ; autre fournisseur : souvent sub).
OIDC_IDENTITY_CLAIMS=tid,oid
# Locataires Microsoft acceptés, séparés par des virgules ; vide = tous (USERS_FILE filtre).
OIDC_TENANTS=
# Comptes autorisés, hors dépôt : modèle dans infra/users.example.toml.
USERS_FILE=
# Sessions : durée maximale après la connexion et durée maximale sans activité.
SESSION_MAX_HOURS=10
SESSION_IDLE_MINUTES=60
# Rôles et permissions ; vide = apps/api/src/alliance_api/roles.toml.
ROLES_FILE=
# Origines acceptées pour les requêtes qui modifient (proxy, nom de domaine), séparées par des
# virgules ; celle de l'application est toujours acceptée.
ALLOWED_ORIGINS=
# Dossier des Items : <user>/<AAAA-MM-JJ>/items.jsonl (contrat A), écrit par le lot 1.
# Vide = journées de démonstration de contracts/fixtures/demo.
DATA_DIR=
# Retours utile / pas utile / faux : un fichier <user>.jsonl par utilisateur, relu par
# l'évaluation (L3.6). Vide = en mémoire, perdus au redémarrage.
FEEDBACK_DIR=
# Démonstration de l'interface : « annotations » affiche les briefs de référence annotés
# (eval/annotations/dev) au lieu du générateur du lot 2, pour les jours annotés. Vide = lot 2.
DEMO_BRIEFS=
DEMO_ANNOTATOR=guillaume-carrier
# Score de priorité du lot 2 : « appris » (MiniLM + poids appris, ADR-0003) ou « regles ».
# Vide = appris ; si le modèle manque, le brief garde les règles et l'annonce.
ALLIANCE_SCORE=
# Jetons OAuth du lot 1 (chiffrés). Clé : `uv run python -m packages.collect.auth keygen`.
TOKEN_KEY=
# Dossier des jetons chiffrés ; vide = ~/.local/share/alliance-briefing/tokens.
TOKENS_DIR=
