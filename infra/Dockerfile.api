FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /usr/local/bin/uv
WORKDIR /app
# contracts/ et packages/ ne sont pas des paquets installés : l'API les importe depuis /app.
# FASTEMBED_CACHE_PATH : modèle d'embeddings du score appris (lot 2), rangé dans l'image.
ENV PYTHONPATH=/app FASTEMBED_CACHE_PATH=/app/.models
COPY . .
# Dépendances du projet racine : l'API et celles du lot 2 (numpy, fastembed).
RUN uv sync --frozen --no-dev
# Modèle téléchargé à la construction (0,22 Go) : le premier brief n'attend pas le réseau.
RUN uv run --no-sync python -c "from packages.analyse.scoring.learned import download_model; download_model()"
EXPOSE 8000
CMD ["uv", "run", "--no-sync", "uvicorn", "alliance_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
