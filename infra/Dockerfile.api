FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /usr/local/bin/uv
WORKDIR /app
# contracts/ et packages/ ne sont pas des paquets installés : l'API les importe depuis /app.
ENV PYTHONPATH=/app
COPY . .
RUN uv sync --frozen --no-dev --package alliance-api
EXPOSE 8000
CMD ["uv", "run", "--no-sync", "uvicorn", "alliance_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
